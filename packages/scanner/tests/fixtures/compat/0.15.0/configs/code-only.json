{
  "estate": "acme-code",
  "scanner": {
    "agentId": "scanent-acme-code",
    "signingKeyEnv": "SCANNER_SIGNING_KEY"
  },
  "outputs": [
    {
      "kind": "file",
      "dir": "/out"
    }
  ],
  "schedule": {
    "everyHours": 24
  },
  "sources": [
    {
      "kind": "code",
      "product": "langchain",
      "roots": [
        {
          "label": "agents",
          "path": "/estate"
        }
      ]
    }
  ]
}
