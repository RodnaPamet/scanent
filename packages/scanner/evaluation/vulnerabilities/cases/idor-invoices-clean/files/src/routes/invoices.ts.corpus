import express from 'express';
import { requireUser } from '../auth';
import { db } from '../db';

export const invoices = express.Router();

invoices.get('/invoices/:id', requireUser, async (req, res) => {
    const invoice = await db.invoice.findFirst({ where: { id: req.params.id, ownerId: req.session.userId } });
    if (!invoice) return res.status(404).end();
    res.json(invoice);
});
