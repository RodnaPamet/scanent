{
  "name": "@rodnapamet/scanent-contract",
  "version": "0.16.0",
  "license": "BUSL-1.1",
  "description": "The scanner report contract: the strict report schemas, the harness ladder, the findings planner, and the signature and canonical-JSON rules a report is verified by.",
  "author": "Inflect Ltd.",
  "repository": {
    "type": "git",
    "url": "https://github.com/RodnaPamet/scanent.git",
    "directory": "packages/contract"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "prepack": "tsc -b ."
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
