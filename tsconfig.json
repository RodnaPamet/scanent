// The whole-repository type-check: every package's source and tests, nothing
// emitted. `@rodnapamet/scanent-contract/*` and `@scanent/report/*` resolve to SOURCE here, so a
// type-check needs no prior build. `npm run build` uses each package's own
// tsconfig instead.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "@rodnapamet/scanent-contract/*": ["packages/contract/src/*"],
      "@scanent/report/*": ["packages/report/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/tests/**/*.ts"]
}
