{
  "name": "scanent",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "scanent, the Agent Estate Scanner: reads an estate's agent sources read-only and produces a signed harness report.",
  "author": "Inflect Ltd.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contract",
    "packages/scanner",
    "packages/report"
  ],
  "scripts": {
    "build": "tsc -b packages/contract packages/report packages/scanner",
    "clean": "tsc -b --clean packages/contract packages/report packages/scanner",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:long": "SCANENT_LONG=1 node --expose-gc node_modules/jest/bin/jest.js",
    "soak": "node scripts/soak.js",
    "docs:access": "node scripts/render-access.js",
    "docs:examples": "node scripts/render-examples.js",
    "docs:network": "node scripts/render-network-and-permissions.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
