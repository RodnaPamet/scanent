# scanent credentials. Fill in each value, or use a secret store.
# This file is read by `docker run --env-file` and by Compose. Keep it 0600.
# There, a value is taken as written: no quotes. For any variable NAME, NAME_FILE=/path reads the value from a file instead.
# Do not load this file with the shell (`. scanent.env`) as it stands: the shell rewrites $, #, ; and spaces in a
# value. From a checkout, keep each value in a file and use the NAME_FILE form, which reads the same everywhere.

# The Ed25519 signing key (PKCS#8 PEM). A file, because a PEM has line breaks.
SCANNER_SIGNING_KEY_FILE=/etc/scanent/signing-key.pem

# Entra: client secret of the application holding Application.Read.All.
ENTRA_CLIENT_SECRET=

# Azure Key Vault: client secret of the application holding Key Vault Reader.
AZURE_CLIENT_SECRET=

# Okta: SSWS API token of a Read-only Administrator.
OKTA_API_TOKEN=

# GitHub: fine-grained token with Contents: Read-only and Secrets: Read-only.
GITHUB_READ_TOKEN=

# Google Cloud: the service-account key file (JSON). A file, because the key has line breaks.
GCP_SCANNER_KEY_FILE=

# LangSmith: service key holding the workspace Viewer role.
LANGSMITH_API_KEY=

# MCP server crm: a token that can list tools and nothing else.
MCP_CRM_TOKEN=

# Entra integrations: client secret of the application holding Application.Read.All and Directory.Read.All (and AuditLog.Read.All for sign-in activity). It may be the entra-sp application.
ENTRA_INTEGRATIONS_CLIENT_SECRET=
