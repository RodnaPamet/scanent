{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scanent chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "schedule": { "type": "string", "minLength": 1 },
    "timeZone": { "type": "string" },
    "strict": { "type": "boolean" },
    "activeDeadlineSeconds": { "type": "integer", "minimum": 60 },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "successful": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "config": {
      "description": "The scanner configuration. Its shape is the scanner's own strict schema, which also refuses anything shaped like a secret; this chart does not repeat it.",
      "type": "object"
    },
    "existingConfigMap": { "type": "string" },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["env", "key"],
            "properties": {
              "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
              "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$" }
            }
          }
        }
      }
    },
    "codeRoots": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["existingClaim", "mountPath"],
        "properties": {
          "existingClaim": { "type": "string", "minLength": 1 },
          "mountPath": { "type": "string", "pattern": "^/[^\\s]*$" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["pvc", "existingClaim", "emptyDir"] },
        "size": { "type": "string", "minLength": 1 },
        "storageClassName": { "type": "string" },
        "existingClaim": { "type": "string" }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpsProxy": {
          "description": "No userinfo: a proxy password is a credential.",
          "type": "string",
          "pattern": "^(https?://[^@/\\s]+/?)?$"
        },
        "noProxy": { "type": "string" }
      }
    },
    "extraCa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingConfigMap": { "type": "string" },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flavor": { "enum": ["none", "kubernetes", "cilium"] },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": { "type": "string", "minLength": 1 },
            "podLabels": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "cidrs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9A-Fa-f.:]+/[0-9]{1,3}$" } }
          }
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cidr", "port"],
            "properties": {
              "cidr": { "type": "string", "pattern": "^[0-9A-Fa-f.:]+/[0-9]{1,3}$" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": { "type": "string", "pattern": "^([0-9A-Fa-f.:]+/[0-9]{1,3})?$" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fqdns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
          }
        }
      }
    },
    "egressProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "privateCidrs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9A-Fa-f.:]+/[0-9]{1,3}$" } }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
        "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "operator": { "enum": ["Exists", "Equal"] },
          "value": { "type": "string" },
          "effect": { "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] },
          "tolerationSeconds": { "type": "integer" }
        }
      }
    }
  }
}
